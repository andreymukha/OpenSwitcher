ACTION!="add|change", GOTO="openswitcher_input_end"

SUBSYSTEM=="input", KERNEL=="event*", ENV{ID_INPUT_KEYBOARD}=="1", TAG+="uaccess", TAG+="openswitcher-input"
SUBSYSTEM=="input", KERNEL=="event*", ENV{ID_INPUT_MOUSE}=="1", TAG+="uaccess", TAG+="openswitcher-input"
SUBSYSTEM=="input", KERNEL=="event*", ENV{ID_INPUT_TOUCHPAD}=="1", TAG+="uaccess", TAG+="openswitcher-input"
SUBSYSTEM=="input", KERNEL=="event*", ENV{ID_INPUT_TRACKPOINT}=="1", TAG+="uaccess", TAG+="openswitcher-input"
SUBSYSTEM=="input", KERNEL=="event*", ENV{ID_INPUT_POINTINGSTICK}=="1", TAG+="uaccess", TAG+="openswitcher-input"
SUBSYSTEM=="misc", KERNEL=="uinput", TAG+="uaccess", TAG+="openswitcher-input", OPTIONS+="static_node=uinput"

LABEL="openswitcher_input_end"
