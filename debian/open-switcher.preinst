#!/bin/sh
set -e

# Этот fallback намеренно дублирует минимальную stop-логику: во время первого
# upgrade новый session-stop helper ещё не распакован, а старый пропускает
# неактивные графические сессии с живым user manager.
is_local_graphical_session() {
    session="$1"
    remote="$(loginctl show-session "$session" -p Remote --value 2>/dev/null || true)"
    session_type="$(loginctl show-session "$session" -p Type --value 2>/dev/null || true)"
    session_class="$(loginctl show-session "$session" -p Class --value 2>/dev/null || true)"

    [ "$remote" != "yes" ] || return 1
    [ "$session_class" = "user" ] || return 1

    case "$session_type" in
        wayland|x11) return 0 ;;
        *) return 1 ;;
    esac
}

run_user_systemctl() {
    uid="$1"
    user="$2"
    shift 2

    runuser -u "$user" -- env \
        "XDG_RUNTIME_DIR=/run/user/$uid" \
        "DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/$uid/bus" \
        systemctl --user "$@"
}

wait_for_guardian_inactive() {
    uid="$1"
    user="$2"

    command -v timeout >/dev/null 2>&1 || return 0
    # Переменные внутри строки раскрывает дочерний shell пользователя.
    # shellcheck disable=SC2016
    runuser -u "$user" -- env \
        "XDG_RUNTIME_DIR=/run/user/$uid" \
        "DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/$uid/bus" \
        timeout --signal=KILL 7s sh -c '
            while :; do
                state="$(
                    systemctl --user show \
                        --property=ActiveState \
                        --value \
                        open-switcher-xtest-guardian.service \
                        2>/dev/null
                )" || exit 0
                case "$state" in
                    active|activating|deactivating|reloading)
                        sleep 0.1
                        ;;
                    *)
                        exit 0
                        ;;
                esac
            done
        ' || true
}

stop_for_user() {
    uid="$1"
    user="$2"

    run_user_systemctl "$uid" "$user" \
        stop open-switcher-tray.service || true
    run_user_systemctl "$uid" "$user" \
        stop open-switcher-daemon.service || true
    wait_for_guardian_inactive "$uid" "$user"
    run_user_systemctl "$uid" "$user" \
        stop open-switcher-xtest-guardian.socket || true
    run_user_systemctl "$uid" "$user" \
        stop open-switcher-xtest-guardian.service || true
    run_user_systemctl "$uid" "$user" daemon-reload || true
}

stop_all_local_user_managers() {
    command -v loginctl >/dev/null 2>&1 || return 0
    command -v runuser >/dev/null 2>&1 || return 0
    command -v systemctl >/dev/null 2>&1 || return 0

    seen_uids=" "
    loginctl list-sessions --no-legend 2>/dev/null | while read -r session _rest; do
        [ -n "$session" ] || continue
        is_local_graphical_session "$session" || continue

        uid="$(loginctl show-session "$session" -p User --value 2>/dev/null || true)"
        user="$(loginctl show-session "$session" -p Name --value 2>/dev/null || true)"
        case "$uid" in
            ""|*[!0-9]*) continue ;;
        esac
        [ -n "$user" ] || continue
        [ -d "/run/user/$uid" ] || continue
        [ -S "/run/user/$uid/bus" ] || continue

        case "$seen_uids" in
            *" $uid "*) continue ;;
        esac
        seen_uids="${seen_uids}${uid} "

        stop_for_user "$uid" "$user"
    done
}

if [ "${1:-}" = "upgrade" ]; then
    if [ -x /usr/lib/open-switcher/open-switcher-user-session-stop ]; then
        /usr/lib/open-switcher/open-switcher-user-session-stop || true
    fi
    stop_all_local_user_managers
fi

#DEBHELPER#

exit 0
