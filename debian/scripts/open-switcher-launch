#!/bin/sh
set -eu

command -v systemctl >/dev/null 2>&1 || exit 1

systemctl --user import-environment \
    DISPLAY \
    WAYLAND_DISPLAY \
    XAUTHORITY \
    XDG_SESSION_TYPE \
    XDG_CURRENT_DESKTOP \
    XDG_SESSION_DESKTOP \
    DESKTOP_SESSION \
    DBUS_SESSION_BUS_ADDRESS || true

systemctl --user start open-switcher-tray.service
